<!--
  Pick-and-place scene for Tutorial 4 (ITR Lab 3).
  * HEAL 6-DoF arm (kinematics/inertias copied from arm_gripper.xml, meshes in heal_meshes/)
  * Parallel-jaw gripper built from primitives (no external meshes needed)
  * Table sized from the workspace analysis (scripts/workspace_analysis.py)
  * Tray (placement target) and a 5 cm cube with a free joint

  Collision filtering (contype / conaffinity):
    robot geoms : contype 2, conaffinity 0  -> robot never collides with itself
    table/tray/cube : contype 1, conaffinity 3  -> collide with robot and each other
    floor       : contype 1, conaffinity 1  -> only collides with the cube
-->
<mujoco model="heal_pick_place">
  <compiler angle="radian" meshdir="heal_meshes/" inertiafromgeom="auto" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10" noslip_iterations="10"/>
  <statistic center="0.35 0 0.3" extent="1.2"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5"/>
  </visual>

  <default>
    <default class="robot_col">
      <geom contype="2" conaffinity="0" group="3"/>
    </default>
    <default class="robot_vis">
      <geom contype="0" conaffinity="0" group="1" material="arm"/>
    </default>
    <default class="env">
      <geom contype="1" conaffinity="3" condim="3" friction="1 0.005 0.0001"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="arm" rgba="0.78 0.78 0.80 1" specular="0.4" shininess="0.6"/>
    <material name="dark" rgba="0.12 0.12 0.13 1"/>
    <material name="pad" rgba="0.25 0.25 0.28 1"/>
    <material name="wood" rgba="0.62 0.47 0.32 1"/>
    <material name="tray" rgba="0.15 0.45 0.75 1"/>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link_1.STL"/>
    <mesh name="link2" file="link_2.STL"/>
    <mesh name="link3" file="link_3.STL"/>
    <mesh name="link4" file="link_4.STL"/>
    <mesh name="link5" file="link_5.STL"/>
    <mesh name="end_effector" file="end_effector.STL"/>
  </asset>

  <worldbody>
    <light pos="0.4 0 1.8" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>
    <camera name="overview" pos="1.35 0.75 0.95" xyaxes="-0.65 0.76 0 -0.365 -0.313 0.877" fovy="50"/>
    <camera name="top" pos="0.40 -0.05 1.6" xyaxes="0 -1 0 1 0 0" fovy="45"/>

    <!-- ================= HEAL arm ================= -->
    <body name="base_link" pos="0 0 0">
      <geom name="base_link_visual" type="mesh" mesh="base_link" class="robot_vis"/>
      <body name="link_1" pos="0 0 0.171">
        <inertial pos="-12.54E-03 -0.04E-03 111.27E-03" quat="0.704455 -0.0304055 0.0162858 0.70891"
                  mass="7.92" diaginertia="0.00490984 0.00426023 0.00389513"/>
        <joint name="joint_1" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
        <geom type="mesh" mesh="link1" class="robot_vis"/>
        <geom name="link_1_collision" type="mesh" mesh="link1" class="robot_col"/>
        <body name="link_2" pos="0 0.0875 0.1498" quat="0.707105 0.707108 0 0">
          <inertial pos="-0.00017021 0.1561 -0.016973" quat="0.499892 0.50026 -0.499813 0.500035"
                    mass="1.24" diaginertia="0.0097684 0.0086581 0.0014536"/>
          <joint name="joint_2" axis="0 0 -1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
          <geom type="mesh" mesh="link2" class="robot_vis"/>
          <geom name="link_2_collision" type="mesh" mesh="link2" class="robot_col"/>
          <body name="link_3" pos="0 0.3 0" euler="0 0 -1.57">
            <inertial pos="-7.5516e-07 0 0.073251" quat="0.495149 0.509997 -0.506629 0.487912"
                      mass="5.57" diaginertia="0.0048786 0.00425304 0.00369796"/>
            <joint name="joint_3" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
            <geom type="mesh" mesh="link3" class="robot_vis"/>
            <geom name="link_3_collision" type="mesh" mesh="link3" class="robot_col"/>
            <body name="link_4" pos="0 0.1593 0.0875" euler="-1.57 0 0">
              <inertial pos="1.3303e-05 0.06 0.10412" quat="0.313668 0.63349 -0.634256 0.313086"
                        mass="1.9" diaginertia="0.00162547 0.0014257 0.00104183"/>
              <joint name="joint_4" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
              <geom type="mesh" mesh="link4" class="robot_vis"/>
              <geom name="link_4_collision" type="mesh" mesh="link4" class="robot_col"/>
              <body name="link_5" pos="0 0.03185 0.16105" euler="0.50951 0 1.57">
                <inertial pos="-5.6194e-05 -0.046 0.059696" quat="0.457117 0.537094 0.438555 0.556994"
                          mass="1.78" diaginertia="0.000913478 0.000827593 0.000774169"/>
                <joint name="joint_5" axis="0 0 1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
                <geom type="mesh" mesh="link5" class="robot_vis"/>
                <geom name="link_5_collision" type="mesh" mesh="link5" class="robot_col"/>
                <body name="end_effector" pos="0 -0.1227 0.0654" quat="0.707105 0.707108 0 0">
                  <inertial pos="7.0245e-06 -0.00022138 -0.016847" quat="-0.0128774 0.707029 0.00995758 0.706998"
                            mass="0.05" diaginertia="0.000326122 0.000191249 0.000189678"/>
                  <joint name="joint_6" axis="0 0 -1" range="-3.14159 3.14159" damping="55" frictionloss="0.1"/>
                  <site name="right_center" pos="0 0 0" size="0.01" rgba="1 0.3 0.3 1" group="2"/>
                  <geom type="mesh" mesh="end_effector" class="robot_vis"/>
                  <geom name="end_effector_collision" type="mesh" mesh="end_effector" class="robot_col"/>

                  <!-- ========== parallel-jaw gripper (approach axis = +z of this frame) ========== -->
                  <body name="gripper_base" pos="0 0 0">
                    <inertial pos="0 0 0.018" mass="0.30" diaginertia="4e-4 4e-4 3e-4"/>
                    <geom name="palm" type="box" size="0.045 0.022 0.0125" pos="0 0 0.0175"
                          class="robot_col" group="1" material="dark"/>
                    <body name="finger_left" pos="0 0 0.03">
                      <inertial pos="-0.008 0 0.03" mass="0.05" diaginertia="2e-5 2e-5 1e-5"/>
                      <joint name="finger_left_joint" type="slide" axis="-1 0 0" range="0 0.045"
                             damping="2" armature="0.001"/>
                      <geom name="finger_left_pad" type="box" size="0.006 0.020 0.03" pos="-0.008 0 0.03"
                            class="robot_col" group="1" material="pad" condim="4"
                            friction="1.5 0.02 0.002"/>
                    </body>
                    <body name="finger_right" pos="0 0 0.03">
                      <inertial pos="0.008 0 0.03" mass="0.05" diaginertia="2e-5 2e-5 1e-5"/>
                      <joint name="finger_right_joint" type="slide" axis="1 0 0" range="0 0.045"
                             damping="2" armature="0.001"/>
                      <geom name="finger_right_pad" type="box" size="0.006 0.020 0.03" pos="0.008 0 0.03"
                            class="robot_col" group="1" material="pad" condim="4"
                            friction="1.5 0.02 0.002"/>
                    </body>
                    <!-- TCP: between the pads, 1.5 cm above the fingertips -->
                    <site name="tcp" pos="0 0 0.075" size="0.006" rgba="0 1 0 1" group="2"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ================= Table (see report: L x W x H = 0.40 x 0.90 x 0.235 m) ================= -->
    <body name="table" pos="0.40 0 0.215">
      <geom name="table_top" type="box" size="0.20 0.45 0.02" class="env" material="wood"/>
      <geom type="cylinder" size="0.02 0.1075" pos=" 0.17  0.42 -0.1275" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.1075" pos=" 0.17 -0.42 -0.1275" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.1075" pos="-0.17  0.42 -0.1275" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.1075" pos="-0.17 -0.42 -0.1275" contype="0" conaffinity="0" material="wood"/>
    </body>

    <!-- ================= Tray: inner 0.16 x 0.16 m, walls 6 cm high, yawed 0.4 rad ================= -->
    <body name="tray" pos="0.40 -0.28 0.235" euler="0 0 0.4">
      <geom name="tray_floor" type="box" size="0.09 0.09 0.004" pos="0 0 0.004" class="env" material="tray"/>
      <geom name="tray_wall_n" type="box" size="0.09 0.005 0.03" pos="0  0.085 0.03" class="env" material="tray"/>
      <geom name="tray_wall_s" type="box" size="0.09 0.005 0.03" pos="0 -0.085 0.03" class="env" material="tray"/>
      <geom name="tray_wall_e" type="box" size="0.005 0.08 0.03" pos=" 0.085 0 0.03" class="env" material="tray"/>
      <geom name="tray_wall_w" type="box" size="0.005 0.08 0.03" pos="-0.085 0 0.03" class="env" material="tray"/>
    </body>

    <!-- ================= Cube (pose randomised every episode) ================= -->
    <body name="cube" pos="0.45 0.15 0.261">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1" class="env"
            rgba="0.85 0.2 0.2 1" condim="4" friction="1.5 0.02 0.002"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="turret" joint="joint_1"/>
    <motor name="shoulder" joint="joint_2"/>
    <motor name="elbow" joint="joint_3"/>
    <motor name="wrist_1" joint="joint_4"/>
    <motor name="wrist_2" joint="joint_5"/>
    <motor name="wrist_3" joint="joint_6"/>
    <position name="finger_left_act" joint="finger_left_joint" kp="800" ctrlrange="-0.01 0.045" forcerange="-30 30"/>
    <position name="finger_right_act" joint="finger_right_joint" kp="800" ctrlrange="-0.01 0.045" forcerange="-30 30"/>
  </actuator>
</mujoco>
