<!--
  Pick-and-place scene for Tutorial 4 - FRANKA EMIKA PANDA version.
  * Panda 7-DoF arm: official kinematics (same body offsets / joint limits as the
    MuJoCo Menagerie panda.xml), primitive capsule links, approximate inertias.
    (The starter zip's franka_scene.xml referenced mjx_panda.xml / arena / plate files
     that were not included, so the arm is rebuilt here without external meshes.)
  * Parallel-jaw gripper: same design that was validated on the HEAL arm, mounted on
    the Panda flange (0.107 m) with the Panda hand's 45 deg offset.
  * Table sized from the workspace analysis (scripts/workspace_analysis.py)
  * Tray (placement target) and a 5 cm cube with a free joint

  Collision filtering (contype / conaffinity):
    robot geoms     : contype 2, conaffinity 0 -> robot never collides with itself
    table/tray/cube : contype 1, conaffinity 3 -> collide with robot and each other
    floor           : contype 1, conaffinity 1 -> only collides with the cube
-->
<mujoco model="panda_pick_place">
  <compiler angle="radian" inertiafromgeom="auto" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="10" noslip_iterations="10"/>
  <statistic center="0.45 0 0.3" extent="1.3"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5"/>
  </visual>

  <default>
    <default class="panda">
      <joint axis="0 0 1" armature="0.1"/>
      <geom type="capsule" contype="2" conaffinity="0" group="1" material="panda_white"/>
    </default>
    <default class="robot_col">
      <geom contype="2" conaffinity="0" group="3"/>
    </default>
    <default class="env">
      <geom contype="1" conaffinity="3" condim="3" friction="1 0.005 0.0001"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="panda_white" rgba="0.95 0.95 0.95 1" specular="0.5" shininess="0.5"/>
    <material name="panda_dark" rgba="0.15 0.15 0.15 1"/>
    <material name="dark" rgba="0.12 0.12 0.13 1"/>
    <material name="pad" rgba="0.25 0.25 0.28 1"/>
    <material name="wood" rgba="0.62 0.47 0.32 1"/>
    <material name="tray" rgba="0.15 0.45 0.75 1"/>
  </asset>

  <worldbody>
    <light pos="0.4 0 1.8" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>
    <camera name="overview" pos="1.65 0.95 1.15" xyaxes="-0.661 0.751 0.000 -0.391 -0.344 0.854" fovy="50"/>
    <camera name="top" pos="0.48 -0.05 2.0" xyaxes="0 -1 0 1 0 0" fovy="45"/>

    <!-- ================= Franka Emika Panda ================= -->
    <body name="link0" childclass="panda">
      <inertial pos="-0.041 0 0.05" mass="0.63" diaginertia="0.003 0.003 0.003"/>
      <geom type="cylinder" size="0.09 0.07" pos="0 0 0.07" material="panda_dark" contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0.333">
        <inertial pos="0.0039 0.0021 -0.0476" mass="4.97" diaginertia="0.07 0.07 0.009"/>
        <joint name="joint1" range="-2.8973 2.8973" damping="40"/>
        <geom fromto="0 0 -0.19 0 0 -0.03" size="0.065"/>
        <body name="link2" quat="1 -1 0 0">
          <inertial pos="-0.0031 -0.0287 0.0035" mass="0.65" diaginertia="0.028 0.026 0.008"/>
          <joint name="joint2" range="-1.7628 1.7628" damping="40"/>
          <geom fromto="0 0 -0.06 0 0 0.06" size="0.06"/>
          <geom fromto="0 0 0 0 -0.21 0" size="0.06"/>
          <body name="link3" pos="0 -0.316 0" quat="1 1 0 0">
            <inertial pos="0.0275 0.0393 -0.0665" mass="3.23" diaginertia="0.037 0.036 0.011"/>
            <joint name="joint3" range="-2.8973 2.8973" damping="40"/>
            <geom fromto="0 0 -0.11 0 0 -0.01" size="0.06"/>
            <geom fromto="0 0 0 0.0825 0 0" size="0.055"/>
            <body name="link4" pos="0.0825 0 0" quat="1 1 0 0">
              <inertial pos="-0.0532 0.1044 0.0275" mass="3.59" diaginertia="0.026 0.020 0.028"/>
              <joint name="joint4" range="-3.0718 -0.0698" damping="40"/>
              <geom fromto="0 0 -0.06 0 0 0.06" size="0.055"/>
              <geom fromto="0 0 0 -0.0825 0.07 0" size="0.055"/>
              <geom fromto="-0.0825 0.07 0 -0.0825 0.26 0" size="0.05"/>
              <body name="link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                <inertial pos="-0.0120 0.0411 -0.0384" mass="1.23" diaginertia="0.036 0.029 0.009"/>
                <joint name="joint5" range="-2.8973 2.8973" damping="8"/>
                <geom fromto="0 0 -0.12 0 0 -0.02" size="0.05"/>
                <body name="link6" quat="1 1 0 0">
                  <inertial pos="0.0601 -0.0141 -0.0105" mass="1.67" diaginertia="0.002 0.004 0.005"/>
                  <joint name="joint6" range="-0.0175 3.7525" damping="8"/>
                  <geom fromto="0 0 -0.05 0 0 0.03" size="0.05"/>
                  <geom fromto="0 0 0 0.088 0 0" size="0.045"/>
                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0">
                    <inertial pos="0.0105 -0.0043 0.0616" mass="0.74" diaginertia="0.013 0.010 0.005"/>
                    <joint name="joint7" range="-2.8973 2.8973" damping="5"/>
                    <geom fromto="0 0 -0.04 0 0 0.08" size="0.045" material="panda_dark"/>
                    <site name="flange" pos="0 0 0.107" size="0.008" rgba="1 0.3 0.3 1" group="2"/>

                    <!-- ===== parallel-jaw gripper (approach axis = +z, closing axis = x) ===== -->
                    <body name="gripper_base" pos="0 0 0.107" quat="0.9238795 0 0 0.3826834">
                      <inertial pos="0 0 0.018" mass="0.60" diaginertia="1e-3 1e-3 6e-4"/>
                      <geom name="palm" type="box" size="0.045 0.022 0.0125" pos="0 0 0.0175"
                            class="robot_col" group="1" material="panda_white"/>
                      <body name="finger_left" pos="0 0 0.03">
                        <inertial pos="-0.008 0 0.03" mass="0.05" diaginertia="2e-5 2e-5 1e-5"/>
                        <joint name="finger_left_joint" type="slide" axis="-1 0 0" range="0 0.045"
                               damping="2" armature="0.001"/>
                        <geom name="finger_left_pad" type="box" size="0.006 0.020 0.03" pos="-0.008 0 0.03"
                              class="robot_col" group="1" material="pad" condim="4"
                              friction="1.5 0.02 0.002"/>
                      </body>
                      <body name="finger_right" pos="0 0 0.03">
                        <inertial pos="0.008 0 0.03" mass="0.05" diaginertia="2e-5 2e-5 1e-5"/>
                        <joint name="finger_right_joint" type="slide" axis="1 0 0" range="0 0.045"
                               damping="2" armature="0.001"/>
                        <geom name="finger_right_pad" type="box" size="0.006 0.020 0.03" pos="0.008 0 0.03"
                              class="robot_col" group="1" material="pad" condim="4"
                              friction="1.5 0.02 0.002"/>
                      </body>
                      <site name="tcp" pos="0 0 0.075" size="0.006" rgba="0 1 0 1" group="2"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ================= Table (see report: L x W x H = 0.48 x 1.10 x 0.20 m) ================= -->
    <body name="table" pos="0.48 0 0.18">
      <geom name="table_top" type="box" size="0.24 0.55 0.02" class="env" material="wood"/>
      <geom type="cylinder" size="0.02 0.08" pos=" 0.21  0.52 -0.10" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.08" pos=" 0.21 -0.52 -0.10" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.08" pos="-0.21  0.52 -0.10" contype="0" conaffinity="0" material="wood"/>
      <geom type="cylinder" size="0.02 0.08" pos="-0.21 -0.52 -0.10" contype="0" conaffinity="0" material="wood"/>
    </body>

    <!-- ================= Tray: inner 0.16 x 0.16 m, walls 6 cm high, yawed 0.4 rad ================= -->
    <body name="tray" pos="0.50 -0.32 0.20" euler="0 0 0.4">
      <geom name="tray_floor" type="box" size="0.09 0.09 0.004" pos="0 0 0.004" class="env" material="tray"/>
      <geom name="tray_wall_n" type="box" size="0.09 0.005 0.03" pos="0  0.085 0.03" class="env" material="tray"/>
      <geom name="tray_wall_s" type="box" size="0.09 0.005 0.03" pos="0 -0.085 0.03" class="env" material="tray"/>
      <geom name="tray_wall_e" type="box" size="0.005 0.08 0.03" pos=" 0.085 0 0.03" class="env" material="tray"/>
      <geom name="tray_wall_w" type="box" size="0.005 0.08 0.03" pos="-0.085 0 0.03" class="env" material="tray"/>
    </body>

    <!-- ================= Cube (pose randomised every episode) ================= -->
    <body name="cube" pos="0.50 0.15 0.226">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.1" class="env"
            rgba="0.85 0.2 0.2 1" condim="4" friction="1.5 0.02 0.002"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="actuator1" joint="joint1" ctrlrange="-87 87"/>
    <motor name="actuator2" joint="joint2" ctrlrange="-87 87"/>
    <motor name="actuator3" joint="joint3" ctrlrange="-87 87"/>
    <motor name="actuator4" joint="joint4" ctrlrange="-87 87"/>
    <motor name="actuator5" joint="joint5" ctrlrange="-12 12"/>
    <motor name="actuator6" joint="joint6" ctrlrange="-12 12"/>
    <motor name="actuator7" joint="joint7" ctrlrange="-12 12"/>
    <position name="finger_left_act" joint="finger_left_joint" kp="800" ctrlrange="-0.01 0.045" forcerange="-30 30"/>
    <position name="finger_right_act" joint="finger_right_joint" kp="800" ctrlrange="-0.01 0.045" forcerange="-30 30"/>
  </actuator>
</mujoco>
